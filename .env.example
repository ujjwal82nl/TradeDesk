# Database
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_secret_change_me
POSTGRES_DB=trading_platform

# Backend
SECRET_KEY=your_super_secret_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Broker Automated TOTP Credentials
# ---------------------------------------------------------------------------

# DhanHQ (automated 24-hr token generation via Client ID + PIN + TOTP)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_PIN=your_dhan_6_digit_pin
DHAN_TOTP_SECRET=your_dhan_totp_secret

# Zerodha (automated headless login via User ID + Password + TOTP)
ZERODHA_USER_ID=your_zerodha_user_id
ZERODHA_PASSWORD=your_zerodha_password
ZERODHA_TOTP_SECRET=your_zerodha_totp_secret

# INDMoney / INDstocks (automated 24-hr token generation via API Key + MPIN + TOTP)
INDMONEY_CLIENT_ID=your_indmoney_ucc_or_account_id
INDMONEY_API_KEY=your_indstocks_totp_client_id
INDMONEY_MPIN=your_indmoney_mpin
INDMONEY_TOTP_SECRET=your_indstocks_totp_secret

# CoinDCX (Cryptocurrency Exchange - Spot & Futures & Options)
COINDCX_API_KEY=your_coindcx_api_key
COINDCX_API_SECRET=your_coindcx_api_secret
COINDCX_AUTH_TOKEN=Bearer your_coindcx_web_bearer_token_here

# Interactive Brokers (Optional / Planned)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Redis
REDIS_URL=redis://redis:6379

# Telegram Bot Alert Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Port mapping (PORT_HTTP=3080 so it never conflicts with ports 80/3000 on the VPS)
PORT_HTTP=3080
PORT_HTTPS=8443
